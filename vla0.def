Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu22.04

%labels
    Author Codex
    Description VLA-0 Apptainer image without conda
    BaseImage nvidia/cuda:12.8.1-devel-ubuntu22.04

%files
    README.md /opt/vla0/README.md
    LICENSE /opt/vla0/LICENSE
    Makefile /opt/vla0/Makefile
    pyproject.toml /opt/vla0/pyproject.toml
    setup.py /opt/vla0/setup.py
    uv.lock /opt/vla0/uv.lock
    .flake8 /opt/vla0/.flake8
    .gitignore /opt/vla0/.gitignore
    .gitmodules /opt/vla0/.gitmodules
    .pre-commit-config.yaml /opt/vla0/.pre-commit-config.yaml
    configs /opt/vla0/configs
    docker /opt/vla0/docker
    eval /opt/vla0/eval
    libs /opt/vla0/libs
    logs /opt/vla0/logs
    rv_train /opt/vla0/rv_train

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export MUJOCO_GL=egl
    export UV_LINK_MODE=copy
    export VIRTUAL_ENV=/opt/venv
    export CUDA_HOME=/usr/local/cuda
    export PATH=/root/.local/bin:/opt/venv/bin:/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/root/.mujoco/mujoco210/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        libegl1-mesa \
        libglew-dev \
        libglib2.0-0 \
        libgl1 \
        libgl1-mesa-glx \
        libopengl0 \
        libosmesa6-dev \
        libsm6 \
        libxext6 \
        libxrender1 \
        ninja-build \
        pkg-config \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        vim \
        wget
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH=/root/.local/bin:$PATH

    cd /opt/vla0
    uv python install 3.12
    uv venv /opt/venv --python 3.12
    export VIRTUAL_ENV=/opt/venv
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/venv/bin:/root/.local/bin:$PATH
    uv pip install --python /opt/venv/bin/python pip
    uv sync --frozen --active --extra qwen --extra lerobot
    uv pip install --python /opt/venv/bin/python pip
    python -m pip install --no-cache-dir --force-reinstall \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.7.1+cu128 \
        torchvision==0.22.1+cu128
    python -m pip install --no-cache-dir \
        wheel \
        ninja \
        numpy==2.2.6
    export TMPDIR=/tmp/pip-tmp
    mkdir -p "${TMPDIR}"
    MAX_JOBS="$(nproc)" python -m pip install --no-cache-dir --no-build-isolation --no-deps \
        "fla-core==0.4.2" \
        "flash-linear-attention==0.4.2" \
        "causal-conv1d>=1.6.1"
    python -m pip install --no-cache-dir --no-deps \
        https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3+cu12torch2.7cxx11abiTRUE-cp312-cp312-linux_x86_64.whl
    python -m pip install --no-cache-dir --force-reinstall --no-deps \
        nvidia-nccl-cu12==2.29.7

    if [ ! -f libs/LIBERO/setup.py ]; then
        git clone https://github.com/Lifelong-Robot-Learning/LIBERO.git libs/LIBERO
    fi

    mkdir -p libs/LIBERO/libero
    touch libs/LIBERO/libero/__init__.py

    if [ -f libs/LIBERO/libero/libero/benchmark/__init__.py ]; then
        sed -i \
            's/torch.load(init_states_path)/torch.load(init_states_path, weights_only=False)/g' \
            libs/LIBERO/libero/libero/benchmark/__init__.py
    fi

    if [ ! -f libs/egl_probe/setup.py ]; then
        git clone https://github.com/StanfordVL/egl_probe.git libs/egl_probe
    fi

    if [ -f libs/egl_probe/egl_probe/CMakeLists.txt ]; then
        sed -i -E \
            's/cmake_minimum_required[[:space:]]*\\([[:space:]]*VERSION[[:space:]]+[0-9.]+[[:space:]]*\\)/cmake_minimum_required(VERSION 3.5)/I' \
            libs/egl_probe/egl_probe/CMakeLists.txt
    fi

    if [ -f libs/egl_probe/setup.py ]; then
        sed -i \
            's|cmake ..; make -j|cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 ..; make -j|g' \
            libs/egl_probe/setup.py
    fi

    python -m pip install --no-build-isolation -e ./libs/egl_probe
    python -m pip install --no-build-isolation \
        "hydra-core>=1.3,<1.4" \
        "easydict==1.9" \
        "robomimic==0.2.0" \
        "thop==0.1.1.post2209072238" \
        "robosuite==1.4.0" \
        "bddl==1.0.1" \
        "future==0.18.2" \
        "cloudpickle==2.1.0"
    python -m pip install --no-build-isolation -e ./libs/LIBERO
    PIP_REQ_EXTRAS=lerobot python -m pip install --no-build-isolation -e ./libs/RoboVerse
    python -m pip install --no-build-isolation -e .
    python -m pip install --no-deps --force-reinstall \
        https://github.com/bitsandbytes-foundation/bitsandbytes/releases/download/continuous-release_main/bitsandbytes-1.33.7.preview-py3-none-manylinux_2_24_x86_64.whl

    mkdir -p /usr/share/glvnd/egl_vendor.d
    cat > /usr/share/glvnd/egl_vendor.d/10_nvidia.json <<'EOF'
{
    "file_format_version": "1.0.0",
    "ICD": {
        "library_path": "libEGL_nvidia.so.0"
    }
}
EOF
    chmod 644 /usr/share/glvnd/egl_vendor.d/10_nvidia.json

    rm -rf /opt/vla0/.git \
           /opt/vla0/libs/LIBERO/.git \
           /opt/vla0/libs/RoboVerse/.git \
           /opt/vla0/libs/egl_probe/.git

%runscript
    export VIRTUAL_ENV=/opt/venv
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/venv/bin:/root/.local/bin:/usr/local/cuda/bin:$PATH
    cd /opt/vla0
    exec "$@"

%test
    export VIRTUAL_ENV=/opt/venv
    export CUDA_HOME=/usr/local/cuda
    export PATH=/opt/venv/bin:/root/.local/bin:/usr/local/cuda/bin:$PATH
    python --version
    python - <<'EOF'
import importlib.metadata as metadata
import torch
print(torch.__version__, torch.version.cuda)
print("nvidia-nccl-cu12", metadata.version("nvidia-nccl-cu12"))
assert metadata.version("nvidia-nccl-cu12") == "2.29.7"
import flash_attn
import causal_conv1d
print("flash-attn imports ok")
EOF
